{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atra.invalid/schemas/melee-play-grammar-v0.1.schema.json",
  "title": "Atra Melee Play Grammar v0.1",
  "description": "Structural schema for Basic/Play mechanical mappings. Semantic completeness findings are produced by scripts/validate_melee_play_grammar.py.",
  "type": "object",
  "required": ["id", "status", "vocabulary", "state_registry", "techniques"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "vocabulary": {"type": "string", "minLength": 1},
    "state_registry": {"type": "string", "minLength": 1},
    "techniques": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/technique"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "textItem": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["record_ids", "evidence_status", "locators"],
      "properties": {
        "record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "evidence_status": {"enum": ["NOT_SOURCE_SPECIFIC", "PROJECT_RULE", "EXACT_LOCATOR_VERIFIED", "EVIDENCE INCOMPLETE", "PROTOTYPE_ONLY"]},
        "locators": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["op", "label"],
      "properties": {
        "op": {"enum": ["ATTACK", "CANCEL", "SET", "CLEAR", "RETAIN", "MODIFY_ATTACK", "REPLACE_PENDING_ATTACK", "RESTRICT_RESPONSE"]},
        "label": {"type": "string", "minLength": 1},
        "target": {"type": "string"},
        "state": {"enum": ["guard", "contact", "measure", "contact_zone", "pressure", "point_threat", "loaded", "recovery", "action_available", "guard_change_available", "spiritus", "committed", "learned_chain_count", "pending_attack", "crown_context"]},
        "value": {},
        "requires": {"type": "string"},
        "parameters": {"type": "object"},
        "exceptional_justification": {"type": "string"}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["event", "note"],
      "properties": {
        "event": {"enum": ["displacement", "historical_timing_label", "historical_action_label", "source_facing_transition"]},
        "note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "technique": {
      "type": "object",
      "required": [
        "id", "name", "status", "historical_source", "trigger", "cost_commitment", "test",
        "primary_payload", "state_aftermath", "continuation", "opponent_counterplay", "event_metadata",
        "nearest_basic_alternative", "distinct_reason", "reason_types", "simulator_representation",
        "ghost_utility", "missing_effect_exposed", "completeness_classification", "exceptional_rule"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["Basic", "governing provisional", "candidate", "incomplete"]},
        "historical_source": {"$ref": "#/$defs/source"},
        "trigger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textItem"}},
        "cost_commitment": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textItem"}},
        "test": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textItem"}},
        "primary_payload": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "state_aftermath": {"type": "array", "items": {"$ref": "#/$defs/operation"}},
        "continuation": {"type": "array", "items": {"type": "string"}},
        "opponent_counterplay": {"type": "array", "items": {"type": "string"}},
        "event_metadata": {"type": "array", "items": {"$ref": "#/$defs/event"}},
        "nearest_basic_alternative": {"type": "string", "minLength": 1},
        "distinct_reason": {"type": "string"},
        "reason_types": {
          "type": "array",
          "items": {"enum": ["intrinsic", "state-dependent", "repertoire-dependent", "resource-dependent", "none"]},
          "uniqueItems": true
        },
        "simulator_representation": {
          "type": "object",
          "required": ["level", "notes"],
          "properties": {
            "level": {"enum": ["full", "partial", "none", "not_applicable"]},
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        },
        "ghost_utility": {
          "type": "object",
          "required": ["present", "notes"],
          "properties": {"present": {"type": "boolean"}, "notes": {"type": "string"}},
          "additionalProperties": false
        },
        "missing_effect_exposed": {
          "type": "object",
          "required": ["present", "notes"],
          "properties": {"present": {"type": "boolean"}, "notes": {"type": "string"}},
          "additionalProperties": false
        },
        "completeness_classification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "COMPLETE",
              "COMPLETE — REPERTOIRE-DEPENDENT",
              "COMPLETE — RESOURCE/STATE-DEPENDENT",
              "REDUNDANT WITH BASIC",
              "INCOMPLETE PAYLOAD",
              "GHOST VALUE",
              "EXCEPTIONAL RESPONSE MODIFIER",
              "TOO VAGUE / REQUIRES DECOMPOSITION",
              "CANDIDATE ONLY"
            ]
          }
        },
        "exceptional_rule": {
          "type": "object",
          "required": ["present", "notes"],
          "properties": {"present": {"type": "boolean"}, "notes": {"type": "string"}},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
